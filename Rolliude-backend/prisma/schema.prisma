generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum ClassificacaoIndicativa {
  L
  DEZ       @map("10")
  DOZE      @map("12")
  QUATORZE  @map("14")
  DEZESSEIS @map("16")
  DEZOITO   @map("18")

  @@map("classificacao_indicativa")
}

model Filme {
  id                      String                  @id @default(uuid())
  titulo                  String
  tituloOriginal          String?                 @map("titulo_original")
  tituloBusca             String                  @default("") @map("titulo_busca")
  sinopse                 String
  posterUrl               String                  @map("poster_url")
  backdropUrl             String                  @map("backdrop_url")
  trailerUrl              String                  @map("trailer_url")
  videoUrl                String                  @map("video_url")
  ano                     Int
  duracaoMinutos          Int                     @map("duracao_minutos")
  genero                  String[]
  classificacaoIndicativa ClassificacaoIndicativa @default(L) @map("classificacao_indicativa")
  localizacaoPais         String                  @map("localizacao_pais")
  localizacaoRegiao       String                  @map("localizacao_regiao")
  localizacaoEstado       String                  @map("localizacao_estado")
  localizacaoEstadoSigla  String                  @map("localizacao_estado_sigla")
  localizacaoMunicipio    String                  @map("localizacao_municipio")
  direcao                 String[]
  roteiro                 String[]
  producao                String[]
  fotografia              String
  trilhaSonora            String                  @map("trilha_sonora")
  produtora               String
  premios                 String[]
  curiosidades            String[]
  destaqueCuradoria       Boolean                 @default(false) @map("destaque_curadoria")
  curadoriaTag            String?                 @map("curadoria_tag")
  popularidade            Int                     @default(0)
  notaMedia               Float                   @default(0) @map("nota_media")
  avaliacoesCount         Int                     @default(0) @map("avaliacoes_count")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  elenco                  ElencoItem[]
  bastidores              ItemBastidores[]
  avaliacoes              Avaliacao[]
  profissionais           Profissional[]          @relation("ProfissionalFilmes")

  @@index([ano])
  @@index([destaqueCuradoria])
  @@index([localizacaoEstadoSigla])
  @@index([genero], type: Gin)
  @@index([tituloBusca(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("filmes")
}

model ElencoItem {
  id         String  @id @default(uuid())
  filmeId    String  @map("filme_id")
  nome       String
  personagem String
  foto       String?
  ordem      Int     @default(0)
  filme      Filme   @relation(fields: [filmeId], references: [id], onDelete: Cascade)

  @@index([filmeId])
  @@map("elenco_itens")
}

model ItemBastidores {
  id             String   @id @default(uuid())
  filmeId        String   @map("filme_id")
  titulo         String
  tipo           String
  descricao      String
  duracao        String?
  thumbnailUrl   String   @map("thumbnail_url")
  videoUrl       String?  @map("video_url")
  galeriaFotos   String[] @map("galeria_fotos")
  entrevistado   String?
  dataPublicacao DateTime @map("data_publicacao")
  filme          Filme    @relation(fields: [filmeId], references: [id], onDelete: Cascade)

  @@index([filmeId])
  @@map("itens_bastidores")
}

model Avaliacao {
  id         String   @id @default(uuid())
  filmeId    String   @map("filme_id")
  autor      String
  cidade     String
  nota       Int
  comentario String
  createdAt  DateTime @default(now()) @map("created_at")
  filme      Filme    @relation(fields: [filmeId], references: [id], onDelete: Cascade)

  @@index([filmeId, createdAt(sort: Desc)])
  @@map("avaliacoes")
}

model Profissional {
  id          String   @id @default(uuid())
  nome        String
  funcoes     String[]
  foto        String
  cidadeNatal String   @map("cidade_natal")
  estadoNatal String   @map("estado_natal")
  biografia   String
  premios     String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  filmes      Filme[]  @relation("ProfissionalFilmes")

  @@map("profissionais")
}
