generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum PapelUsuario {
  USUARIO
  CURADOR
  ADMINISTRADOR

  @@map("papel_usuario")
}

model Usuario {
  id                  String               @id @default(uuid())
  email               String               @unique
  nome                String
  senha               String?
  googleId            String?              @unique
  papel               PapelUsuario         @default(USUARIO)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]

  @@map("usuarios")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum RegiaoBrasil {
  NORTE
  NORDESTE
  CENTRO_OESTE
  SUDESTE
  SUL

  @@map("regiao_brasil")
}

enum ClassificacaoIndicativa {
  L
  DEZ       @map("10")
  DOZE      @map("12")
  QUATORZE  @map("14")
  DEZESSEIS @map("16")
  DEZOITO   @map("18")

  @@map("classificacao_indicativa")
}

model Estado {
  id         String       @id @default(uuid())
  uf         String       @unique
  nome       String
  regiao     RegiaoBrasil
  municipios Municipio[]

  @@index([regiao])
  @@map("estados")
}

model Municipio {
  id       String  @id @default(uuid())
  nome     String
  estadoId String
  estado   Estado  @relation(fields: [estadoId], references: [id])
  filmes   Filme[]

  @@unique([estadoId, nome])
  @@map("municipios")
}

model Genero {
  id     String  @id @default(uuid())
  nome   String  @unique
  filmes Filme[]
  id     String        @id @default(uuid())
  nome   String        @unique
  filmes FilmeGenero[]

  @@map("generos")
}

enum StatusFilme {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

model Filme {
  id                      String      @id @default(uuid())
  titulo                  String
  sinopse                 String?
  diretor                 String?
  anoLancamento           Int?
  duracaoMinutos          Int?
  idioma                  String      @default("pt-BR")
  classificacaoIndicativa String?
  posterUrl               String?
  trailerUrl              String?
  videoFileName           String?
  dominioPublico          Boolean     @default(false)
  status                  StatusFilme @default(RASCUNHO)
  generos                 Genero[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([status])
  @@index([anoLancamento])
  id                      String                  @id @default(uuid())
  titulo                  String
  tituloOriginal          String?                 @map("titulo_original")
  tituloBusca             String                  @default("") @map("titulo_busca")
  sinopse                 String?
  anoLancamento           Int?                    @map("ano_lancamento")
  duracaoMin              Int?                    @map("duracao_min")
  classificacaoIndicativa ClassificacaoIndicativa @default(L) @map("classificacao_indicativa")
  idiomaOriginal          String?                 @map("idioma_original")
  posterUrl               String?                 @map("poster_url")
  trailerUrl              String?                 @map("trailer_url")
  videoUrl                String?
  dominioPublico          Boolean                 @default(false)
  publicado               Boolean                 @default(false)
  municipioId             String?                 @map("municipio_id")
  municipio               Municipio?              @relation(fields: [municipioId], references: [id])
  generos                 FilmeGenero[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([titulo])
  @@index([anoLancamento])
  @@index([publicado, createdAt(sort: Desc)])
  @@index([municipioId])
  @@index([tituloBusca(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("filmes")
}

model FilmeGenero {
  filmeId  String @map("filme_id")
  generoId String @map("genero_id")
  filme    Filme  @relation(fields: [filmeId], references: [id], onDelete: Cascade)
  genero   Genero @relation(fields: [generoId], references: [id], onDelete: Restrict)

  @@id([filmeId, generoId])
  @@index([generoId])
  @@map("filme_genero")
}
