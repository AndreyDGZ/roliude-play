generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMIN
  USER
}

enum ClassificacaoIndicativa {
  L
  DEZ
  DOZE
  QUATORZE
  DEZESSEIS
  DEZOITO
}

enum RegiaoBrasil {
  NORTE
  NORDESTE
  CENTRO_OESTE
  SUDESTE
  SUL
}

model Usuario {
  id                  String               @id @default(uuid())
  nome                String
  email               String               @unique
  senha               String
  role                PapelUsuario         @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]

  @@map("usuarios")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Estado {
  id         String      @id @default(uuid())
  uf         String      @unique
  nome       String
  regiao     RegiaoBrasil
  municipios Municipio[]

  @@map("estados")
}

model Municipio {
  id       String   @id @default(uuid())
  nome     String
  estadoId String   @map("estado_id")
  estado   Estado   @relation(fields: [estadoId], references: [id])
  filmes   Filme[]

  @@map("municipios")
}

model Genero {
  id     String        @id @default(uuid())
  nome   String        @unique
  filmes FilmeGenero[]

  @@map("generos")
}

model Filme {
  id                      String                  @id @default(uuid())
  titulo                  String
  tituloOriginal          String?                 @map("titulo_original")
  tituloBusca             String                  @default("") @map("titulo_busca")
  sinopse                 String?
  anoLancamento           Int?                    @map("ano_lancamento")
  duracaoMin              Int?                    @map("duracao_min")
  classificacaoIndicativa ClassificacaoIndicativa @default(L) @map("classificacao_indicativa")
  idiomaOriginal          String?                 @map("idioma_original")
  posterUrl               String?                 @map("poster_url")
  trailerUrl              String?                 @map("trailer_url")
  videoUrl                String?
  dominioPublico          Boolean                 @default(false)
  publicado               Boolean                 @default(false)
  municipioId             String?                 @map("municipio_id")
  municipio               Municipio?              @relation(fields: [municipioId], references: [id])
  generos                 FilmeGenero[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([titulo])
  @@index([anoLancamento])
  @@index([publicado, createdAt(sort: Desc)])
  @@index([municipioId])
  @@map("filmes")
}

model FilmeGenero {
  filmeId  String @map("filme_id")
  generoId String @map("genero_id")
  filme    Filme  @relation(fields: [filmeId], references: [id], onDelete: Cascade)
  genero   Genero @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@id([filmeId, generoId])
  @@map("filme_generos")
}